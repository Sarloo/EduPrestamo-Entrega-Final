# Copy this file to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# Use a cryptographically random value of at least 32 bytes outside local testing.
# Example generator: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRES_IN=1h

# SQLite file used by node:sqlite. Docker Compose overrides this path so that
# the database is stored in its named volume.
DATABASE_PATH=./data/eduprestamo.sqlite

# Comma-separated origins may be supported by the application configuration.
CORS_ORIGIN=http://localhost:3000

# Authentication safeguards from the project requirements.
LOGIN_MAX_ATTEMPTS=3
LOCKOUT_MINUTES=15

# Optional one-time administrator bootstrap. Set these only while running
# `npm run seed:admin`, then remove them from the local environment.
ADMIN_NAME=School administrator
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-strong-temporary-password
